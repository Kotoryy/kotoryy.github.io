# Настройки сервера для российского хостинга (Apache). GitHub Pages этот файл не использует.

# Своя страница для несуществующих адресов
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.kotoryy.ru → https://kotoryy.ru (один адрес сайта для поисковиков)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http → https. Перед Apache на хостинге стоит прокси, поэтому проверяем и его заголовок,
  # и сам Apache — иначе получится бесконечная переадресация
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Файлы в /_astro/ меняют имя при каждом изменении — их можно кэшировать надолго
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(jpe?g|png|webp|svg|ico)$#">
    # картинки (обложки могут замениться файлом с тем же именем) — сутки
    Header set Cache-Control "public, max-age=86400"
  </ElseIf>
  <Else>
    # страницы, RSS, поиск — всегда свежие
    Header set Cache-Control "no-cache"
  </Else>
</IfModule>
